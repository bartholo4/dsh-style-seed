{
  "name": "dsh-style-seed",
  "version": "0.2.0-experimental.13",
  "private": true,
  "description": "Experimental per-session weneed switch for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/bartholo4/dsh-style-seed.git"
  },
  "homepage": "https://github.com/bartholo4/dsh-style-seed#readme",
  "bugs": "https://github.com/bartholo4/dsh-style-seed/issues",
  "keywords": ["dsh-plugin", "deepseek-harness", "reasoning", "session"],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:known-issue": "node --test --test-reporter=tap tests/lifecycle-disposal.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "client.bundle.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-alpha.2",
    "zod": "4.6.7",
    "react": "^18.2.0"
  }
}
